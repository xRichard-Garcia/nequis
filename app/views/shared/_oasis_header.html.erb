<header class="sticky top-0 z-40 bg-brand-cream/90 backdrop-blur-md border-b border-brand-border/80" data-purpose="main-navigation" data-controller="mobile-menu" data-action="click@window->mobile-menu#closeOnOutsideClick">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <nav aria-label="Navegación principal" class="hidden lg:flex items-center space-x-9 text-xs font-medium tracking-wide uppercase text-brand-dark/80">
      <%= link_to "Inicio", root_path, class: "text-brand-dark font-semibold border-b border-brand-dark pb-0.5", aria: { current: "page" } %>
      <%= link_to "Colección", root_path(anchor: "coleccion"), class: "hover:text-brand-purple transition-colors" %>
      <%= link_to "Personalizar", root_path(anchor: "personalizacion"), class: "hover:text-brand-purple transition-colors" %>
      <%= link_to "Sobre nosotros", about_path, class: "hover:text-brand-purple transition-colors" %>
    </nav>

    <%= link_to root_path, class: "flex flex-col items-center group py-2", data: { purpose: "brand-logo" }, aria: { label: "NEQUIS, ir al inicio" } do %>
      <%= image_tag "nequis/nequis-logo.png",
            alt: "NEQUIS",
            class: "h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105",
            width: 1119,
            height: 629 %>
      <span class="text-[9px] font-bold tracking-[0.22em] text-brand-muted uppercase -mt-1">Sublimación &amp; DTF</span>
    <% end %>

    <div class="flex items-center space-x-4 sm:space-x-6 text-xs font-medium tracking-wide" data-purpose="utility-actions">
      <%= link_to "Catálogo DTF", root_path(anchor: "coleccion"), class: "hidden sm:inline-block text-brand-dark/80 hover:text-brand-purple transition-colors" %>

      <button type="button" aria-label="Buscar" class="text-brand-dark/80 hover:text-brand-purple transition-colors p-1">
        <svg class="w-4 h-4 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <%= link_to root_path(anchor: "coleccion"), class: "relative text-brand-dark/80 hover:text-brand-purple transition-colors p-1", aria: { label: "Carrito de compras" } do %>
        <svg class="w-4 h-4 stroke-[1.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25c-.669 0-1.189-.578-1.119-1.243l1.263-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-brand-yellow text-brand-purple text-[9px] font-bold rounded-full flex items-center justify-center" data-shop-target="cartCount" aria-live="polite">0</span>
      <% end %>

      <button type="button"
              class="lg:hidden text-brand-dark/80 hover:text-brand-purple transition-colors p-1"
              aria-label="Abrir menú de navegación"
              aria-expanded="false"
              aria-controls="mobile-navigation"
              data-mobile-menu-target="button"
              data-action="click->mobile-menu#toggle">
        <svg data-mobile-menu-target="openIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
        </svg>
        <svg data-mobile-menu-target="closeIcon" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-navigation"
       class="absolute inset-x-0 top-full hidden lg:hidden border-b border-brand-border bg-brand-cream shadow-lg"
       data-mobile-menu-target="panel">
    <nav class="max-w-7xl mx-auto px-6 py-3 flex flex-col text-xs font-semibold uppercase tracking-wide text-brand-dark/80" aria-label="Navegación móvil" data-action="click->mobile-menu#close">
      <%= link_to "Inicio", root_path, class: "py-3 border-b border-brand-border/60 hover:text-brand-purple transition-colors", aria: { current: "page" } %>
      <%= link_to "Colección", root_path(anchor: "coleccion"), class: "py-3 border-b border-brand-border/60 hover:text-brand-purple transition-colors" %>
      <%= link_to "Personalizar", root_path(anchor: "personalizacion"), class: "py-3 border-b border-brand-border/60 hover:text-brand-purple transition-colors" %>
      <%= link_to "Sobre nosotros", about_path, class: "py-3 border-b border-brand-border/60 hover:text-brand-purple transition-colors" %>
    </nav>
  </div>
</header>
