        <svg class="w-4 h-4 fill-none stroke-current stroke-[1.8]" viewBox="0 0 24 24" aria-hidden="true">
          <rect height="20" rx="5" ry="5" width="20" x="2" y="2"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
        </svg>
        <span class="text-xs font-semibold tracking-wide">Instagram</span>
      </a>
      <a aria-label="TikTok" class="flex items-center space-x-2 px-4 py-2.5 rounded-full border border-brand-border bg-white text-brand-dark hover:border-brand-purple hover:text-brand-purple hover:bg-brand-soft-lilac/80 transition-all duration-300 shadow-sm" href="https://tiktok.com" rel="noopener" target="_blank">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.27 6.27 0 0 0 1.99-4.52V8.92a8.28 8.28 0 0 0 4.78 1.52V7a4.8 4.8 0 0 1-1-.31z"></path>
