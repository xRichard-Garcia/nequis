      <a aria-label="WhatsApp" class="flex items-center space-x-2 px-4 py-2.5 rounded-full border border-brand-border bg-white text-brand-dark hover:border-brand-purple hover:text-brand-purple hover:bg-brand-soft-lilac/80 transition-all duration-300 shadow-sm" href="https://wa.me/50577040918" rel="noopener" target="_blank">
        <svg class="w-4 h-4 fill-none stroke-current stroke-[1.8]" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span class="text-xs font-semibold tracking-wide">WhatsApp</span>
      </a>
      <a aria-label="Facebook" class="flex items-center space-x-2 px-4 py-2.5 rounded-full border border-brand-border bg-white text-brand-dark hover:border-brand-purple hover:text-brand-purple hover:bg-brand-soft-lilac/80 transition-all duration-300 shadow-sm" href="https://facebook.com" rel="noopener" target="_blank">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
        </svg>
        <span class="text-xs font-semibold tracking-wide">Facebook</span>
      </a>
      <a aria-label="Pinterest" class="flex items-center space-x-2 px-4 py-2.5 rounded-full border border-brand-border bg-white text-brand-dark hover:border-brand-purple hover:text-brand-purple hover:bg-brand-soft-lilac/80 transition-all duration-300 shadow-sm" href="https://pinterest.com" rel="noopener" target="_blank">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.4 9.3-.09-.79-.17-2 .04-2.86.19-.79 1.25-5.27 1.25-5.27s-.32-.64-.32-1.58c0-1.48.86-2.59 1.93-2.59.91 0 1.35.68 1.35 1.5 0 .91-.58 2.28-.88 3.55-.25 1.06.53 1.93 1.58 1.93 1.89 0 3.35-1.99 3.35-4.87 0-2.55-1.83-4.33-4.45-4.33-3.03 0-4.81 2.27-4.81 4.62 0 .92.35 1.9.79 2.43.09.1.1.2.07.31-.08.33-.26 1.05-.3 1.2-.05.19-.16.23-.37.14-1.38-.64-2.24-2.65-2.24-4.27 0-3.48 2.53-6.68 7.3-6.68 3.83 0 6.81 2.73 6.81 6.38 0 3.81-2.4 6.88-5.74 6.88-1.12 0-2.18-.58-2.54-1.27l-.69 2.63c-.25.96-.93 2.16-1.38 2.9A10 10 0 1 0 12 2z"></path>
        </svg>
        <span class="text-xs font-semibold tracking-wide">Pinterest</span>
      </a>
    </div>

    <div class="w-full max-w-md border-t border-brand-border/60 pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] text-brand-muted gap-2">
      <p>© <%= Time.current.year %> NEQUIS Sublimación y DTF.</p>
      <p>Nicaragua • Envíos a todo el país</p>
    </div>
  </div>
</footer>
