<footer id="contacto" class="bg-brand-cream border-t border-brand-border text-brand-dark py-16 scroll-mt-24" data-purpose="main-footer">
  <div class="max-w-4xl mx-auto px-6 text-center flex flex-col items-center">
    <%= link_to root_path, class: "flex flex-col items-center group mb-6", aria: { label: "NEQUIS, ir al inicio" } do %>
      <%= image_tag "nequis/nequis-logo.png",
            alt: "NEQUIS",
            class: "h-14 w-auto object-contain transition-transform duration-300 group-hover:scale-105",
            width: 1119,
            height: 629 %>
      <span class="text-[10px] font-bold tracking-[0.25em] text-brand-muted uppercase -mt-1">Sublimación &amp; DTF</span>
    <% end %>

    <p class="font-editorial text-xl sm:text-2xl text-brand-dark font-normal italic max-w-md mb-2">
      "Ideas que se convierten en productos"
    </p>
    <p class="text-xs text-brand-muted font-light mb-8 max-w-sm">
      Síguenos en nuestras redes sociales para descubrir proyectos diarios, promociones y proceso en taller.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-10">

      <a aria-label="WhatsApp" class="flex items-center space-x-2 px-4 py-2.5 rounded-full border border-brand-border bg-white text-brand-dark hover:border-brand-purple hover:text-brand-purple hover:bg-brand-soft-lilac/80 transition-all duration-300 shadow-sm" href="https://wa.me/50577040918" rel="noopener" target="_blank">
        <svg class="w-4 h-4 fill-none stroke-current stroke-[1.8]" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span class="text-xs font-semibold tracking-wide">WhatsApp</span>
      </a>

    </div>

    <div class="w-full max-w-md border-t border-brand-border/60 pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] text-brand-muted gap-2">
      <p>© <%= Time.current.year %> NEQUIS Sublimación y DTF.</p>
      <p>Nicaragua • Envíos a todo el país</p>
    </div>
  </div>
</footer>
