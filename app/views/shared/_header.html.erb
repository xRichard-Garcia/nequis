<header class="fixed top-0 left-0 right-0 w-full z-50 bg-surface/90 backdrop-blur-xl shadow-[0_4px_24px_rgba(46,31,56,0.06)]">
  <div class="h-28 max-w-7xl mx-auto px-6 lg:px-12 flex flex-col justify-between py-space-sm">
    <div class="flex items-center justify-between gap-space-md">
      <div class="flex items-center gap-space-sm">
        <a class="flex items-center gap-space-xs" href="<%= root_path %>" aria-label="NEQUIS, ir al inicio">
          <span class="w-9 h-9 rounded-full bg-primary-fixed flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">redeem</span>
          </span>
          <span class="font-headline-lg text-headline-lg tracking-wider text-primary">NEQUIS</span>
        </a>
        <span class="hidden sm:inline-block px-space-sm py-1 bg-tertiary-fixed text-on-tertiary-fixed font-label-sm text-label-sm rounded-full">Regalos &amp; Sublimación</span>
      </div>

      <div class="flex-1 max-w-md mx-space-md hidden md:block">
        <div class="relative flex items-center" role="search">
          <input
            class="w-full bg-surface-container-low rounded-full pl-10 pr-4 py-2 font-body-sm text-body-sm text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary shadow-inner"
            placeholder="Buscar tazas, camisetas, cojines personalizados..."
            type="search"
            aria-label="Buscar productos personalizados"
            autocomplete="off"
          >
          <span class="material-symbols-outlined absolute left-3 text-outline text-[20px]" aria-hidden="true">search</span>
        </div>
      </div>

      <div class="flex items-center gap-space-sm">
        <a class="p-2 rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all flex items-center justify-center" href="https://wa.me/+50577040918" target="_blank" rel="noopener noreferrer" aria-label="Atención al cliente por WhatsApp">
          <span class="material-symbols-outlined text-[22px]" aria-hidden="true">support_agent</span>
        </a>
        <a class="relative p-2 rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all flex items-center justify-center" href="<%= root_path(anchor: "catalogo") %>" aria-label="Ver carrito de compras">
          <span class="material-symbols-outlined text-[22px]" aria-hidden="true">shopping_bag</span>
          <span class="absolute -top-1 -right-1 bg-secondary text-on-secondary font-label-sm text-label-sm w-5 h-5 rounded-full flex items-center justify-center shadow-sm" data-shop-target="cartCount" aria-live="polite">3</span>
        </a>
        <a class="flex items-center gap-2 pl-space-xs" href="<%= root_path(anchor: "contacto") %>" aria-label="Mi cuenta">
          <span class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shadow-sm">
            <span class="material-symbols-outlined text-on-primary text-[18px]" aria-hidden="true">person</span>
          </span>
        </a>
      </div>
    </div>

    <div class="overflow-x-auto overflow-y-hidden">
      <nav class="flex items-center gap-1 min-w-max py-1" aria-label="Navegación principal">
        <a class="<%= nav_link_classes(current_page?(root_path)) %>" <%= 'aria-current="page"'.html_safe if current_page?(root_path) %> href="<%= root_path %>">Inicio</a>
        <a class="<%= nav_link_classes(current_page?(about_path)) %>" <%= 'aria-current="page"'.html_safe if current_page?(about_path) %> href="<%= about_path %>">Sobre Nequis</a>
        <a class="<%= nav_link_classes(false) %>" href="<%= root_path(anchor: "experiencia") %>">Conoce la sublimación</a>
        <a class="<%= nav_link_classes(false) %>" href="<%= root_path(anchor: "personaliza") %>">Servicios</a>
        <a class="<%= nav_link_classes(false) %>" href="<%= root_path(anchor: "catalogo") %>">Catálogo</a>
        <a class="<%= nav_link_classes(false) %>" href="<%= root_path(anchor: "catalogo") %>">Stock</a>
        <a class="<%= nav_link_classes(false) %>" href="<%= root_path(anchor: "momentos") %>">Nuestro trabajo</a>
        <a class="<%= nav_link_classes(false) %>" href="<%= root_path(anchor: "personaliza") %>">Personaliza tu producto</a>
        <a class="<%= nav_link_classes(false) %>" href="<%= root_path(anchor: "personaliza") %>">Así trabajamos</a>
        <a class="<%= nav_link_classes(false) %>" href="<%= root_path(anchor: "momentos") %>">Experiencias</a>
        <a class="<%= nav_link_classes(false) %>" href="<%= root_path(anchor: "contacto") %>">Preguntas</a>
        <a class="<%= nav_link_classes(false) %>" href="<%= root_path(anchor: "contacto") %>">Contacto</a>
      </nav>
    </div>
  </div>
</header>
