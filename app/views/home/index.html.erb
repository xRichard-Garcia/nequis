<% content_for :title, "Inicio - NEQUIS Sublimación & DTF" %>
<% content_for :meta_description, "Diseñamos y estampamos objetos cotidianos con identidad propia. Sublimación y DTF en cerámica, textil y regalos personalizados con acabados premium." %>
<% content_for :theme_color, "#FAFAF7" %>
<% content_for :body_class, "bg-brand-cream text-brand-dark font-brand-sans antialiased selection:bg-brand-purple selection:text-white" %>
<% content_for :oasis_layout, true %>
<% content_for :head do %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="Inicio - NEQUIS Sublimación & DTF">
  <meta property="og:description" content="Ideas que cobran vida en cada detalle. Sublimación y DTF sobre cerámica, textil y regalos personalizados.">
  <meta property="og:image" content="<%= image_url "nequis/bolsa-1.jpeg" %>">
<% end %>

<main data-controller="scroll-reveal">
  <!-- Hero editorial -->
  <section id="inicio" class="relative overflow-hidden border-b border-brand-border/60 bg-linear-to-r from-brand-cream via-brand-surface/40 to-brand-accent-mint/20" data-purpose="hero-editorial-section">
    <div class="max-w-7xl mx-auto px-6 py-12 lg:py-20 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="reveal lg:col-span-6 space-y-8 z-10">
        <div class="space-y-3">
          <span class="inline-block text-[11px] font-semibold tracking-[0.25em] text-brand-purple uppercase bg-brand-soft-lilac/80 px-3 py-1 rounded-full">
            Taller de Personalización • Sublimación &amp; DTF
          </span>
          <h1 class="font-editorial text-5xl sm:text-6xl md:text-7xl lg:text-[76px] leading-[1.04] text-brand-dark font-normal">
            Ideas que cobran vida en cada detalle.
          </h1>
        </div>

        <p class="text-sm md:text-base text-brand-muted max-w-lg font-light leading-relaxed">
          Diseñamos y estampamos objetos cotidianos con identidad propia. Cerámica esmaltada, textil en algodón de alta densidad e insumos premium tratados con técnicas duraderas.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <%= link_to root_path(anchor: "coleccion"), class: "inline-flex items-center space-x-2 bg-brand-dark text-white px-7 py-3.5 rounded text-xs font-semibold tracking-wider uppercase hover:bg-brand-purple transition-all duration-300 shadow-sm hover:shadow" do %>
            <span>Explorar Colección</span>
            <span aria-hidden="true">↗</span>
          <% end %>
        </div>


      </div>

      <div class="reveal lg:col-span-6 relative">
        <div class="absolute -right-12 -top-12 w-96 h-96 bg-brand-accent-mint/40 rounded-full blur-3xl -z-10 pointer-events-none" aria-hidden="true"></div>

        <div class="relative bg-brand-surface rounded-2xl overflow-hidden border border-brand-border/60 shadow-xl shadow-brand-dark/5">
          <%= image_tag "nequis/bolsa-1.jpeg",
                alt: "Artesana sonriente en taller creativo de sublimación sosteniendo una taza personalizada",
                class: "w-full h-auto block transform hover:scale-105 transition-transform duration-700",
                loading: "eager",
                fetchpriority: "high",
                decoding: "async" %>

          <div class="absolute top-5 right-5 bg-brand-purple text-white w-14 h-14 rounded-full flex flex-col items-center justify-center text-[9px] font-bold uppercase tracking-tighter shadow-md">
            <span>DTF</span>
            <span class="text-brand-yellow font-extrabold text-[11px]">&amp; Subli</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Garantías de marca -->
  <section class="border-b border-brand-border/70 bg-white py-6" data-purpose="brand-guarantees">
    <div class="reveal max-w-7xl mx-auto px-6 grid grid-cols-1 sm:grid-cols-3 gap-6 text-center divide-y sm:divide-y-0 sm:divide-x divide-brand-border/60">
      <div class="pt-2 sm:pt-0">
        <p class="font-editorial text-lg text-brand-dark font-medium">Acabado Brillante &amp; Mate</p>
        <p class="text-[11px] text-brand-muted mt-0.5">Polímeros cerámicos de grado AAA</p>
      </div>
      <div class="pt-2 sm:pt-0">
        <p class="font-editorial text-lg text-brand-dark font-medium">Técnica DTF Textil</p>
        <p class="text-[11px] text-brand-muted mt-0.5">Tacto suave sobre 100% algodón</p>
      </div>
      <div class="pt-2 sm:pt-0">
        <p class="font-editorial text-lg text-brand-dark font-medium">Empaque Protegido</p>
        <p class="text-[11px] text-brand-muted mt-0.5">Garantía total anti-rotura</p>
      </div>
    </div>
  </section>

  <!-- Colección popular -->
  <section id="coleccion" class="max-w-7xl mx-auto px-6 py-20 lg:py-24 scroll-mt-24" data-purpose="popular-collection">
    <div class="reveal text-center max-w-2xl mx-auto mb-16 space-y-2">
      <p class="text-[11px] tracking-[0.2em] font-semibold uppercase text-brand-purple">Catálogo Esencial</p>
      <h2 class="font-editorial text-4xl sm:text-5xl text-brand-dark font-normal">Colección Popular</h2>
      <div class="w-12 h-px bg-brand-dark/20 mx-auto mt-4"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <article class="reveal group flex flex-col" data-purpose="product-card">
        <div class="relative bg-brand-surface rounded-xl overflow-hidden aspect-square mb-4 border border-brand-border/60 transition-all duration-300 group-hover:border-brand-purple/40">
          <%= image_tag "nequis/taza-1.jpeg",
                alt: "Taza cerámica artística ilustrada sublimada",
                class: "w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500",
                loading: "lazy",
                decoding: "async" %>
          <span class="absolute top-3 left-3 bg-white/95 text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded text-brand-purple">
            Bestseller
          </span>
          <button type="button" class="absolute bottom-3 right-3 bg-brand-dark text-white p-2.5 rounded-lg opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:bg-brand-purple shadow-md" data-action="click->shop#addToCart" data-compact="true" aria-label="Añadir Taza Mágica al carrito">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
          </button>
        </div>
        <div class="text-center space-y-1">
          <h3 class="text-sm font-medium text-brand-dark group-hover:text-brand-purple transition-colors">Kit esencia</h3>
          <p class="text-xs text-brand-muted font-light">Termo 1lt mas taza con cambio de color al contacto térmico</p>
          <p class="text-sm font-semibold text-brand-dark pt-1">$ 8.990</p>
        </div>
      </article>

      <article class="reveal group flex flex-col" data-purpose="product-card">
        <div class="relative bg-brand-surface rounded-xl overflow-hidden aspect-square mb-4 border border-brand-border/60 transition-all duration-300 group-hover:border-brand-purple/40">
          <%= image_tag "nequis/bolso-3.jpeg",
                alt: "Botella deportiva térmica personalizada con nombre y acabado mate",
                class: "w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500",
                loading: "lazy",
                decoding: "async" %>
          <span class="absolute top-3 left-3 bg-white/95 text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded text-brand-dark">
            Térmico
          </span>
          <button type="button" class="absolute bottom-3 right-3 bg-brand-dark text-white p-2.5 rounded-lg opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:bg-brand-purple shadow-md" data-action="click->shop#addToCart" data-compact="true" aria-label="Añadir Sport al carrito">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
          </button>
        </div>
        <div class="text-center space-y-1">
          <h3 class="text-sm font-medium text-brand-dark group-hover:text-brand-purple transition-colors">Tote bag</h3>
          <p class="text-xs text-brand-muted font-light">Bolsa personalizada con diseño sublimado</p>
          <p class="text-sm font-semibold text-brand-dark pt-1">$ 12.990</p>
        </div>
      </article>

      <article class="reveal group flex flex-col" data-purpose="product-card">
        <div class="relative bg-brand-surface rounded-xl overflow-hidden aspect-square mb-4 border border-brand-border/60 transition-all duration-300 group-hover:border-brand-purple/40">
          <%= image_tag "nequis/camisa.jpeg",
                alt: "Polera blanca doblada con estampado sublimado a todo color",
                class: "w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500",
                loading: "lazy",
                decoding: "async" %>
          <span class="absolute top-3 left-3 bg-brand-yellow text-brand-purple text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded">
            Nuevo
          </span>
          <button type="button" class="absolute bottom-3 right-3 bg-brand-dark text-white p-2.5 rounded-lg opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:bg-brand-purple shadow-md" data-action="click->shop#addToCart" data-compact="true" aria-label="Añadir Polera Soft Touch al carrito">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
          </button>
        </div>
        <div class="text-center space-y-1">
          <h3 class="text-sm font-medium text-brand-dark group-hover:text-brand-purple transition-colors">Camiseta personalizada</h3>
          <p class="text-xs text-brand-muted font-light">Estampado imperceptible al tacto con colores eternos</p>
          <p class="text-sm font-semibold text-brand-dark pt-1">$ 14.990</p>
        </div>
      </article>

      <article class="reveal group flex flex-col" data-purpose="product-card">
        <div class="relative bg-brand-surface rounded-xl overflow-hidden aspect-square mb-4 border border-brand-border/60 transition-all duration-300 group-hover:border-brand-purple/40">
          <%= image_tag "nequis/cojin.jpg",
                alt: "Cojín decorativo personalizado con foto familiar impresa",
                class: "w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500",
                loading: "lazy",
                decoding: "async" %>
          <span class="absolute top-3 left-3 bg-white/95 text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded text-brand-purple">
            Tendencia
          </span>
          <button type="button" class="absolute bottom-3 right-3 bg-brand-dark text-white p-2.5 rounded-lg opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity hover:bg-brand-purple shadow-md" data-action="click->shop#addToCart" data-compact="true" aria-label="Añadir Cojín Foto al carrito">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
          </button>
        </div>
        <div class="text-center space-y-1">
          <h3 class="text-sm font-medium text-brand-dark group-hover:text-brand-purple transition-colors">Cojín Foto</h3>
          <p class="text-xs text-brand-muted font-light">Funda lavable con cierre invisible y relleno acolchado</p>
          <p class="text-sm font-semibold text-brand-dark pt-1">$ 11.990</p>
        </div>
      </article>
    </div>

    <div class="reveal mt-14 text-center">
      <a class="inline-block border-b-2 border-brand-purple pb-1 text-xs font-bold tracking-widest uppercase text-brand-purple hover:text-brand-dark transition-colors" href="https://wa.me/50577040918?text=Hola%20NEQUIS%2C%20quiero%20ver%20el%20cat%C3%A1logo%20completo" target="_blank" rel="noopener noreferrer">
        Ver todos los productos del catálogo completo →
      </a>
    </div>
  </section>

  <!-- Pedidos especiales -->
  <section id="personalizacion" class="max-w-7xl mx-auto px-6 py-20 scroll-mt-24" data-purpose="custom-order-cta">
    <div class="reveal bg-brand-purple rounded-3xl p-10 lg:p-16 text-white relative overflow-hidden shadow-2xl">
      <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none" aria-hidden="true">
        <svg class="w-96 h-96 fill-current text-white" viewBox="0 0 32 32">
          <path d="M16 4c-1.3 0-2.3 1-2.3 2.3 0 .8.4 1.5 1.1 1.9-.9.4-1.7 1-2.4 1.7-.4-.7-1.1-1.1-1.9-1.1-1.3 0-2.3 1-2.3 2.3 0 .7.3 1.3.8 1.7-.8.7-1.5 1.5-1.9 2.5-.7-.4-1.5-.5-2.2-.2-1.2.5-1.8 1.8-1.3 3 .5 1.2 1.8 1.8 3 1.3.6-.3 1-.7 1.3-1.3.6 1 1.4 1.8 2.3 2.4-.2.8-.1 1.6.4 2.3.7 1.1 2.1 1.4 3.2.7 1.1-.7 1.4-2.1.7-3.2-.3-.5-.7-.9-1.3-1.1.8-.7 1.4-1.5 1.9-2.5.7.4 1.5.5 2.2.2 1.2-.5 1.8-1.8 1.3-3-.5-1.2-1.8-1.8-3-1.3-.6.3-1 .7-1.3 1.3-.6-1-1.4-1.8-2.3-2.4.2-.8.1-1.6-.4-2.3-.6-.8-1.6-1.3-2.6-1.3z"></path>
        </svg>
      </div>

      <div class="relative z-10 max-w-2xl space-y-6">
        <span class="inline-block bg-white/10 text-brand-yellow font-bold uppercase tracking-[0.2em] text-[10px] px-3.5 py-1.5 rounded-full border border-white/10">
          Cotizaciones &amp; Pedidos Especiales
        </span>
        <h2 class="font-editorial text-4xl sm:text-5xl lg:text-6xl font-normal leading-tight">
          ¿Tienes un evento, marca o regalo corporativo en mente?
        </h2>
        <p class="text-white/80 text-sm sm:text-base font-light leading-relaxed">
          Hacemos realidad tu proyecto desde 1 muestra hasta miles de tiradas. Sublimación directa en cerámica, aluminio, madera polimerizada y transfer DTF textil de alta precisión.
        </p>
        <div class="pt-4 flex flex-wrap gap-4 items-center">
          <a class="bg-brand-yellow text-brand-purple font-bold text-xs uppercase tracking-wider px-8 py-4 rounded hover:bg-white transition-colors shadow-lg" href="https://wa.me/50577040918?text=Hola%20NEQUIS%2C%20quiero%20cotizar%20un%20pedido%20especial" rel="noopener noreferrer" target="_blank">
            Cotizar por WhatsApp
          </a>
          <a class="text-xs uppercase tracking-wider font-semibold text-white/90 hover:text-white underline underline-offset-4" href="https://wa.me/50577040918?text=Hola%20NEQUIS%2C%20quiero%20la%20plantilla%20de%20dise%C3%B1o" rel="noopener noreferrer" target="_blank">
            Descargar plantilla de diseño (PSD/AI) →
          </a>
        </div>
      </div>
    </div>
  </section>
</main>
