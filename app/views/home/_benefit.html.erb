<div class="p-6 rounded-lg bg-surface-container-lowest shadow-sm hover:shadow-md transition-all flex items-start gap-4">
  <div class="w-14 h-14 shrink-0 rounded-full <%= icon_classes %> flex items-center justify-center shadow-inner">
    <span class="material-symbols-outlined text-[28px]" aria-hidden="true"><%= icon %></span>
  </div>
  <div class="space-y-1">
    <h3 class="font-headline-sm text-headline-sm text-on-surface"><%= title %></h3>
    <p class="font-body-md text-body-md text-on-surface-variant"><%= description %></p>
  </div>
</div>
