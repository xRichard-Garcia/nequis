            <span class="material-symbols-outlined text-[15px]" aria-hidden="true">favorite</span>
            Nuestra Historia &amp; Equipo
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-end">
