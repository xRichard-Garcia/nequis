<% content_for :title, "Sobre NEQUIS - Las Creadoras" %>
<% content_for :meta_description, "Conoce a Joseling, Greyschell y Cinthia, las creadoras detrás de NEQUIS. Creatividad, calidad y pasión por transformar tus ideas en regalos personalizados." %>
<% content_for :head do %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="Sobre NEQUIS - Las Creadoras">
  <meta property="og:description" content="Tres jóvenes emprendedoras unidas por el diseño, la creatividad y la personalización. Conoce la historia detrás de NEQUIS.">
  <meta property="og:image" content="<%= image_url "nequis/creadora-joseling.jpg" %>">
<% end %>

<main class="w-full pt-28 bg-background min-h-screen">
  <div class="flex flex-col w-full">
    <div class="relative w-full overflow-hidden">
      <div class="absolute -top-32 -left-20 w-96 h-96 bg-primary-fixed rounded-full blur-3xl opacity-60 pointer-events-none" aria-hidden="true"></div>
      <div class="absolute top-10 -right-20 w-[420px] h-[420px] bg-secondary-fixed rounded-full blur-3xl opacity-40 pointer-events-none" aria-hidden="true"></div>

