          <h2 id="creadoras-title" class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">Las Creadoras de NEQUIS</h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg items-stretch">
        <article class="group rounded-3xl bg-surface-container-lowest p-space-lg shadow-[0_20px_40px_rgba(46,31,56,0.06)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
