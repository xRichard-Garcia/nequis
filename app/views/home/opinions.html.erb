<% content_for :title, "Opiniones de Clientes - NEQUIS" %>
<% content_for :meta_description, "Historias reales de clientes NEQUIS: reseñas verificadas, experiencias con sublimación y DTF, y regalos personalizados hechos con amor." %>
<% content_for :theme_color, "#FAFAF7" %>
<% content_for :body_class, "bg-brand-cream text-brand-dark font-brand-sans antialiased selection:bg-brand-purple selection:text-white" %>
<% content_for :oasis_layout, true %>
<% content_for :head do %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="Opiniones de Clientes - NEQUIS">
  <meta property="og:description" content="Más de 480 reseñas verificadas. Descubre lo que dicen quienes ya viven la experiencia NEQUIS.">
  <meta property="og:image" content="<%= image_url "nequis/taza.jpeg" %>">
<% end %>

<main id="opiniones" data-controller="scroll-reveal">
  <div class="flex flex-col w-full">
    <!-- Breadcrumb / Brand Tag -->
    <section class="w-full bg-[#FAF5EB] py-3.5 px-6 border-b border-brand-border/60">
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center space-x-2 text-brand-muted text-xs tracking-wider uppercase">
          <%= link_to "Inicio", root_path, class: "hover:text-brand-purple transition-colors" %>
          <span>/</span>
          <span class="text-brand-purple font-semibold">• Testimonios &amp; Experiencias Reales • NEQUIS</span>
        </div>
        <div class="flex items-center space-x-6 text-xs text-brand-muted">
          <span class="flex items-center gap-1.5 text-brand-dark font-medium">
            <span class="material-symbols-outlined text-base text-brand-purple" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">verified</span>
            Opiniones 100% Verificadas
          </span>
          <span class="hidden sm:inline-block text-brand-border">|</span>
          <span class="hidden sm:flex items-center gap-1.5">
            <span class="material-symbols-outlined text-base text-brand-yellow" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">star</span>
            4.9 Calificación Promedio
          </span>
        </div>
      </div>
    </section>

    <!-- Hero editorial -->
    <section class="relative w-full overflow-hidden bg-brand-cream py-16 lg:py-24 border-b border-brand-border/50">
      <div class="absolute -top-24 -left-20 w-96 h-96 rounded-full bg-brand-soft-lilac opacity-50 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute top-1/3 right-0 w-80 h-80 rounded-full bg-brand-yellow/15 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="reveal max-w-5xl mx-auto px-6 text-center flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-soft-lilac text-brand-purple text-xs font-semibold tracking-wider uppercase mb-6">
          <span class="w-2 h-2 rounded-full bg-brand-purple" aria-hidden="true"></span>
          Voces de Nuestra Comunidad
        </div>

        <h1 class="font-editorial text-4xl sm:text-5xl lg:text-6xl text-brand-dark tracking-tight leading-tight max-w-4xl">
          Historias estampadas: <br class="hidden sm:inline">
          <span class="italic font-light text-brand-purple">Lo que dicen quienes confían en NEQUIS</span>
        </h1>

        <p class="font-sans text-brand-muted text-base sm:text-lg max-w-2xl mt-5 leading-relaxed">
          Más de 1.200 sonrisas entregadas en todo el país. Desde regalos emotivos para seres queridos hasta producciones corporativas de alta precisión en sublimación y DTF.
        </p>

        <!-- Trust summary metrics -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full max-w-4xl mt-12 bg-white/80 backdrop-blur-sm p-6 rounded-3xl border border-brand-border shadow-sm">
          <div class="flex flex-col items-center border-r-0 md:border-r border-brand-border/70 py-2">
            <div class="flex items-center gap-1 text-brand-yellow mb-1">
              <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">star</span>
              <span class="font-sans text-2xl font-bold text-brand-dark">4.9</span>
              <span class="text-xs text-brand-muted font-medium">/ 5.0</span>
            </div>
            <span class="text-xs text-brand-muted">Calificación promedio</span>
          </div>
          <div class="flex flex-col items-center border-r-0 md:border-r border-brand-border/70 py-2">
            <span class="font-sans text-2xl font-bold text-brand-purple mb-1">+480</span>
            <span class="text-xs text-brand-muted">Reseñas verificadas</span>
          </div>
          <div class="flex flex-col items-center border-r-0 md:border-r border-brand-border/70 py-2">
            <span class="font-sans text-2xl font-bold text-brand-dark mb-1">99.4%</span>
            <span class="text-xs text-brand-muted">Recomendación total</span>
          </div>
          <div class="flex flex-col items-center py-2">
            <div class="flex items-center gap-1 text-emerald-600 mb-1">
              <span class="material-symbols-outlined text-xl" aria-hidden="true">verified</span>
              <span class="font-sans text-2xl font-bold text-brand-dark">100%</span>
            </div>
            <span class="text-xs text-brand-muted">Calidad &amp; color garantizado</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured testimonial -->
    <section class="w-full bg-white py-16 lg:py-20 px-6 border-b border-brand-border/60">
      <div class="max-w-6xl mx-auto">
        <div class="reveal bg-brand-surface rounded-[2.5rem] border border-brand-border/70 overflow-hidden shadow-sm">
          <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
            <div class="lg:col-span-5 relative h-96 lg:h-full min-h-[420px] bg-brand-border/40">
              <%= image_tag "nequis/opinion-tazsa.jpeg",
                    alt: "Tazas cerámicas personalizadas NEQUIS en empaque de regalo",
                    class: "w-full h-full object-cover",
                    loading: "lazy",
                    decoding: "async" %>
              <div class="absolute top-4 left-4 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/90 backdrop-blur-md text-brand-dark text-xs font-semibold shadow-sm">
                <span class="material-symbols-outlined text-sm text-brand-yellow" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">hotel_class</span>
                Historia Destacada del Mes
              </div>
              <div class="absolute bottom-4 left-4 right-4 p-3 rounded-2xl bg-white/95 backdrop-blur-md border border-brand-border text-xs flex items-center justify-between">
                <span class="font-medium text-brand-dark">Pedido #NQ-8421</span>
                <span class="text-brand-muted flex items-center gap-1">
                  <span class="material-symbols-outlined text-xs text-emerald-600" aria-hidden="true">check_circle</span>
                  Compra verificada
                </span>
              </div>
            </div>

            <div class="lg:col-span-7 p-8 sm:p-12 lg:p-16 flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-1 text-brand-yellow mb-4">
                  <%= render "home/rating", class: "items-center", icon_class: "text-xl" %>
                  <span class="ml-2 text-xs font-semibold text-brand-dark uppercase tracking-wider">Experiencia 5 Estrellas</span>
                </div>
                <blockquote class="font-editorial text-2xl sm:text-3xl lg:text-4xl text-brand-dark font-normal italic leading-snug">
                  “Pedí 35 tazas mágicas personalizadas para el aniversario de mi empresa y la calidad del estampado superó todas las expectativas.”
                </blockquote>
              </div>

              <div class="mt-8 pt-6 border-t border-brand-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                  <h2 class="font-sans font-bold text-base text-brand-dark">Camila Valenzuela</h2>
                  <p class="text-xs text-brand-muted">Directora Creativa</p>
                  <div class="flex flex-wrap items-center gap-2 mt-1">
                    <span class="inline-block px-2.5 py-0.5 rounded-full bg-brand-soft-lilac text-brand-purple text-[11px] font-semibold">
                      Tazas Mágicas Cerámica HD
                    </span>
                    <span class="text-[11px] text-emerald-600 font-medium flex items-center gap-1">
                      <span class="material-symbols-outlined text-xs" aria-hidden="true">verified</span>
                      Verificado con foto
                    </span>
                  </div>
                </div>
                <%= link_to root_path(anchor: "coleccion"), class: "inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-brand-dark text-white text-xs font-semibold hover:bg-brand-purple transition-all self-start sm:self-auto" do %>
                  Ver Tazas Mágicas
                  <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Wall of experiences -->
    <section class="w-full bg-brand-cream py-20 px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <div class="reveal flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-brand-purple">Muro de Experiencias</span>
            <h2 class="font-editorial text-3xl sm:text-4xl text-brand-dark mt-1">Cada detalle cuenta una historia</h2>
          </div>
          <p class="text-xs sm:text-sm text-brand-muted max-w-md">
            Opiniones reales compartidas directamente por quienes han vivido la experiencia de crear sus regalos y productos con nosotros.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Robert Fox -->
          <article class="reveal bg-white rounded-3xl p-6 border border-brand-border shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center space-x-2.5">
                  <div class="w-9 h-9 rounded-full bg-brand-purple text-white flex items-center justify-center text-xs font-bold">RF</div>
                  <div>
                    <h3 class="font-sans font-bold text-sm text-brand-dark whitespace-nowrap">Robert Fox</h3>
                    <p class="text-[11px] text-brand-muted whitespace-nowrap">Santiago • Feb 2026</p>
                  </div>
                </div>
                <%= render "home/rating", class: "shrink-0" %>
              </div>
              <p class="font-sans text-brand-dark text-sm leading-relaxed mb-4">
                "El nivel de detalle en la polera DTF es impresionante. Cero tacto gomoso, lavada tras lavada sigue impecable."
              </p>
            </div>
            <div class="pt-4 border-t border-brand-border/70 flex items-center justify-between text-xs gap-2">
              <span class="px-2.5 py-1 rounded-full bg-brand-surface text-brand-dark font-medium text-[11px] inline-flex items-center gap-1"><span class="material-symbols-outlined text-sm" aria-hidden="true">checkroom</span>Polera Soft Touch DTF</span>
              <span class="text-emerald-600 font-semibold text-[11px] flex items-center gap-1">
                <span class="material-symbols-outlined text-xs" aria-hidden="true">photo_camera</span>
                Foto adjunta
              </span>
            </div>
          </article>

          <!-- Savannah Williams -->
          <article class="reveal bg-white rounded-3xl p-6 border border-brand-border shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center space-x-2.5">
                  <div class="w-9 h-9 rounded-full bg-brand-yellow text-brand-dark flex items-center justify-center text-xs font-bold">SW</div>
                  <div>
                    <h3 class="font-sans font-bold text-sm text-brand-dark whitespace-nowrap">Savannah Williams</h3>
                    <p class="text-[11px] text-brand-muted whitespace-nowrap">Viña del Mar • Ene 2026</p>
                  </div>
                </div>
                <%= render "home/rating", class: "shrink-0" %>
              </div>
              <p class="font-sans text-brand-dark text-sm leading-relaxed mb-4">
                "Compré una taza con ilustración personalizada de mi perrito para mi mamá y lloró de emoción. Gracias al equipo de NEQUIS por tanto amor y paciencia."
              </p>
            </div>
            <div class="pt-4 border-t border-brand-border/70 flex items-center justify-between text-xs gap-2">
              <span class="px-2.5 py-1 rounded-full bg-brand-surface text-brand-dark font-medium text-[11px] inline-flex items-center gap-1"><span class="material-symbols-outlined text-sm" aria-hidden="true">local_cafe</span>Taza Cerámica Ilustrada</span>
              <span class="text-brand-purple font-semibold text-[11px] flex items-center gap-1">
                <span class="material-symbols-outlined text-xs" aria-hidden="true">favorite</span>
                Regalo emotivo
              </span>
            </div>
          </article>

          <!-- Kathryn Murphy -->
          <article class="reveal bg-white rounded-3xl p-6 border border-brand-border shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center space-x-2.5">
                  <div class="w-9 h-9 rounded-full bg-brand-soft-lilac text-brand-purple flex items-center justify-center text-xs font-bold">KM</div>
                  <div>
                    <h3 class="font-sans font-bold text-sm text-brand-dark whitespace-nowrap">Kathryn Murphy</h3>
                    <p class="text-[11px] text-brand-muted whitespace-nowrap">Concepción • Mar 2026</p>
                  </div>
                </div>
                <%= render "home/rating", class: "shrink-0" %>
              </div>
              <p class="font-sans text-brand-dark text-sm leading-relaxed mb-4">
                "La botella térmica mantiene el agua fría más de 24 horas y el grabado/sublimado envolvente no tiene ningún defecto. Calidad premium absoluta."
              </p>
            </div>
            <div class="pt-4 border-t border-brand-border/70 flex items-center justify-between text-xs gap-2">
              <span class="px-2.5 py-1 rounded-full bg-brand-surface text-brand-dark font-medium text-[11px] inline-flex items-center gap-1"><span class="material-symbols-outlined text-sm" aria-hidden="true">water_bottle</span>Botella Inox Sport 304</span>
              <span class="text-emerald-600 font-semibold text-[11px] flex items-center gap-1">
                <span class="material-symbols-outlined text-xs" aria-hidden="true">verified</span>
                Verificado
              </span>
            </div>
          </article>

          <!-- Ignacio M. -->
          <article class="reveal bg-white rounded-3xl p-6 border border-brand-border shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center space-x-2.5">
                  <div class="w-9 h-9 rounded-full bg-brand-dark text-white flex items-center justify-center text-xs font-bold">IM</div>
                  <div>
                    <h3 class="font-sans font-bold text-sm text-brand-dark whitespace-nowrap">Ignacio M.</h3>
                    <p class="text-[11px] text-brand-muted whitespace-nowrap">La Serena • Ene 2026</p>
                  </div>
                </div>
                <%= render "home/rating", class: "shrink-0" %>
              </div>
              <p class="font-sans text-brand-dark text-sm leading-relaxed mb-4">
                "Hicimos tote bags de canvas para la boda de mi hermana. El algodón es pesado de verdad y los colores vivos tal como en el boceto digital."
              </p>
            </div>
            <div class="pt-4 border-t border-brand-border/70 flex items-center justify-between text-xs gap-2">
              <span class="px-2.5 py-1 rounded-full bg-brand-surface text-brand-dark font-medium text-[11px] inline-flex items-center gap-1"><span class="material-symbols-outlined text-sm" aria-hidden="true">shopping_bag</span>Tote Bag Canvas Pesado</span>
              <span class="text-brand-purple font-semibold text-[11px] flex items-center gap-1">
                <span class="material-symbols-outlined text-xs" aria-hidden="true">celebration</span>
                Evento Especial
              </span>
            </div>
          </article>

          <!-- Daniela & Tomás -->
          <article class="reveal bg-white rounded-3xl p-6 border border-brand-border shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center space-x-2.5">
                  <div class="w-9 h-9 rounded-full bg-rose-100 text-rose-800 flex items-center justify-center text-xs font-bold">D&amp;T</div>
                  <div>
                    <h3 class="font-sans font-bold text-sm text-brand-dark whitespace-nowrap">Daniela &amp; Tomás</h3>
                    <p class="text-[11px] text-brand-muted whitespace-nowrap">Providencia • Feb 2026</p>
                  </div>
                </div>
                <%= render "home/rating", class: "shrink-0" %>
              </div>
              <p class="font-sans text-brand-dark text-sm leading-relaxed mb-4">
                "Excelente asesoría por WhatsApp. Nos ayudaron a vectorizar una foto con poca resolución y quedó nítida en el cojín de regalo."
              </p>
            </div>
            <div class="pt-4 border-t border-brand-border/70 flex items-center justify-between text-xs gap-2">
              <span class="px-2.5 py-1 rounded-full bg-brand-surface text-brand-dark font-medium text-[11px] inline-flex items-center gap-1"><span class="material-symbols-outlined text-sm" aria-hidden="true">weekend</span>Cojín Foto Abrazo</span>
              <span class="text-emerald-600 font-semibold text-[11px] flex items-center gap-1">
                <span class="material-symbols-outlined text-xs" aria-hidden="true">support_agent</span>
                Asistencia Gratuita
              </span>
            </div>
          </article>

          <!-- Felipe Arancibia -->
          <article class="reveal bg-white rounded-3xl p-6 border border-brand-border shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center space-x-2.5">
                  <div class="w-9 h-9 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center text-xs font-bold">FA</div>
                  <div>
                    <h3 class="font-sans font-bold text-sm text-brand-dark whitespace-nowrap">Felipe Arancibia</h3>
                    <p class="text-[11px] text-brand-muted whitespace-nowrap">Temuco • Mar 2026</p>
                  </div>
                </div>
                <%= render "home/rating", class: "shrink-0" %>
              </div>
              <p class="font-sans text-brand-dark text-sm leading-relaxed mb-4">
                "Llegó en 48 hrs a región en empaque súper protegido con burbujas y caja lista para regalar. Sin duda volveremos a pedir."
              </p>
            </div>
            <div class="pt-4 border-t border-brand-border/70 flex items-center justify-between text-xs gap-2">
              <span class="px-2.5 py-1 rounded-full bg-brand-surface text-brand-dark font-medium text-[11px] inline-flex items-center gap-1"><span class="material-symbols-outlined text-sm" aria-hidden="true">redeem</span>Pack Regalo Dúo</span>
              <span class="text-brand-purple font-semibold text-[11px] flex items-center gap-1">
                <span class="material-symbols-outlined text-xs" aria-hidden="true">local_shipping</span>
                Envío Express
              </span>
            </div>
          </article>
        </div>


      </div>
    </section>

    <!-- Review submission CTA -->
    <section class="w-full bg-brand-cream py-16 px-6 lg:px-8 border-b border-brand-border/60">
      <div class="reveal max-w-4xl mx-auto bg-white rounded-[2.5rem] p-8 sm:p-12 border border-brand-border shadow-sm flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-lg">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-yellow/20 text-brand-dark text-xs font-semibold">
            <span class="material-symbols-outlined text-sm text-brand-yellow" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">rate_review</span>
            Tu opinión hace crecer este taller
          </span>
          <h2 class="font-editorial text-2xl sm:text-3xl text-brand-dark leading-tight">
            ¿Recibiste tu pedido NEQUIS? <br>
            <span class="italic font-light text-brand-purple">Comparte tu experiencia</span>
          </h2>
          <p class="text-xs sm:text-sm text-brand-muted">
            Ayuda a otras personas a inspirarse con sus ideas. Te toma menos de 2 minutos y recibirás un cupón del 10% en tu próxima creación.
          </p>
        </div>
        <div class="flex flex-col w-full sm:w-auto gap-3">
          <%= link_to "https://wa.me/50577040918?text=Hola%20NEQUIS%2C%20quiero%20escribir%20una%20rese%C3%B1a%20de%20mi%20pedido.", class: "px-7 py-3 rounded-full bg-brand-purple text-white text-xs font-semibold tracking-wide uppercase hover:bg-brand-purple/90 transition-all shadow-sm text-center", target: "_blank", rel: "noopener noreferrer" do %>
            Escribir una reseña
          <% end %>
          <%= link_to "https://wa.me/50577040918?text=Hola%20NEQUIS%2C%20quiero%20verificar%20mi%20compra%20con%20mi%20c%C3%B3digo%20de%20pedido.", class: "px-7 py-3 rounded-full border border-brand-border bg-brand-surface text-brand-dark text-xs font-semibold hover:border-brand-dark transition-all text-center inline-flex items-center justify-center gap-1.5", target: "_blank", rel: "noopener noreferrer" do %>
            <span class="material-symbols-outlined text-base" aria-hidden="true">qr_code_scanner</span>
            Verificar compra con código de pedido
          <% end %>
        </div>
      </div>
    </section>
  </div>
</main>
