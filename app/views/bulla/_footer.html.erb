<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <%= image_tag "bulla/logo.jpg", alt: "Logotipo oficial BULLA" %>
        <p>Agencia creativa y publicitaria. Ideas que conectan, destacan y dejan huella.</p>
      </div>

    </div>

    <div class="footer-bottom">
      <span>© 2026 BULLA. Todos los derechos reservados.</span>
      <% legal_labels = {
           privacidad: "Privacidad",
           cookies: "Cookies",
           terminos: "Términos",
           aviso: "Aviso legal",
           copyright: "Copyright"
         } %>
      <div class="legal-links">
        <% BullaContent::LEGAL_PAGES.each do |key, page| %>
          <%= link_to legal_labels.fetch(key, page[:title]), bulla_legal_path(key: key), title: page[:title] %>
        <% end %>
      </div>
      <span>Los contenidos y elementos visuales están protegidos por los derechos que correspondan.</span>
    </div>
  </div>
</footer>
