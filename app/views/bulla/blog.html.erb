<% content_for :title, "Blog — BULLA" %>

<%= render "bulla/page_hero",
      kicker: "Blog / Bulla Ideas",
      title: "Ideas para marcas que <span class=\"accent\">no se quedan quietas.</span>",
      description: "Consejos y reflexiones sobre marketing, branding, diseño y comunicación. Artículos editoriales de muestra, editables antes de publicar." %>

<section class="section">
  <div class="container">
    <div class="blog-grid">
      <% BullaContent::ARTICLES.each_with_index do |article, index| %>
        <% label = ["MARCA<br>CON VOZ", "CONTENIDO<br>CON INTENCIÓN", "BRIEF<br>CREATIVO"][index] %>
        <article class="article-card">
          <div class="article-visual <%= ["one", "two", "three"][index] %>">
            <span><%= raw label %></span>
          </div>
          <div class="article-body">
            <div class="tag-row">
              <span class="tag"><%= article[:category] %></span>
              <span class="small"><%= article[:date] %></span>
            </div>
            <h3><%= article[:title] %></h3>
            <p><%= article[:excerpt] %></p>
            <%= link_to "Leer artículo", bulla_article_path(id: article[:id]), class: "text-link" %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>
