<article class="team-card">
  <div class="team-photo<%= " has-photo" if person[:photo] %>">
    <% if person[:photo] %>
      <%= image_tag person[:photo], alt: "Fotografía de #{person[:name]}" %>
    <% else %>
      <div class="avatar-mark"><%= person[:initial] %></div>
    <% end %>
  </div>
  <div class="team-info">
    <span class="team-role"><%= person[:role] %></span>
    <h3><%= person[:name] %></h3>
    <p class="team-bio"><%= person[:description] %></p>
    <div class="team-socials">
      <span class="social-label">Redes profesionales</span>
      <div class="social-chips">
        <% Array(person[:socials]).each do |network| %>
          <span class="social-chip" title="Enlace pendiente de configurar"><%= network %></span>
        <% end %>
      </div>
    </div>
  </div>
</article>
