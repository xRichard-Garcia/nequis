<% content_for :title, "Equipo — BULLA" %>

<%= render "bulla/page_hero",
      kicker: "Nuestro equipo / Team",
      title: "Personas que convierten ideas <span class=\"accent\">en movimiento.</span>",
      description: "Seis personas que forman el equipo BULLA. Los cargos, biografías y enlaces se completarán cuando se disponga de información real y aprobada." %>

<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="eyebrow">Conoce al equipo</div>
        <h2>La creatividad es <span class="script">un trabajo en equipo.</span></h2>
      </div>
      <p>Los perfiles que aparecen como pendientes son marcadores provisionales, no datos biográficos.</p>
    </div>
    <div class="grid-2">
      <%= render partial: "bulla/team_card", collection: BullaContent::TEAM, as: :person %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="eyebrow">Tips del equipo</div>
        <h2>Un consejo de cada persona <span class="script">para tu marca.</span></h2>
      </div>
      <p>Toca un nombre para descubrir su recomendación creativa.</p>
    </div>

    <div class="tips-box">
      <div class="tips-tabs" role="tablist" aria-label="Tips del equipo BULLA">
        <% BullaContent::TEAM.each_with_index do |person, index| %>
          <% key = person[:name].parameterize %>
          <button class="tip-tab <%= "active" if index.zero? %>" type="button" role="tab"
                  id="tip-tab-<%= key %>" aria-selected="<%= index.zero? %>" aria-controls="tip-<%= key %>"
                  data-tip-tab data-key="<%= key %>"><%= person[:name] %></button>
        <% end %>
      </div>

      <% BullaContent::TEAM.each_with_index do |person, index| %>
        <% key = person[:name].parameterize %>
        <div class="tip-panel<%= " hidden" unless index.zero? %>" id="tip-<%= key %>"
             role="tabpanel" aria-labelledby="tip-tab-<%= key %>" data-tip-panel data-key="<%= key %>">
          <div class="tip-icon" aria-hidden="true">✳</div>
          <div>
            <div class="tag-row"><span class="tag"><%= person[:tip][:topic] %></span></div>
            <h3><%= person[:tip][:title] %></h3>
            <p><%= person[:tip][:text] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <div class="eyebrow">¿Quieres trabajar con BULLA?</div>
      <h2>Tu próximo proyecto puede empezar <span class="script">con una conversación.</span></h2>
    </div>
    <%= link_to "Escríbenos ↗", bulla_contact_path, class: "btn btn-dark" %>
  </div>
</section>
